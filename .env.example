# WhatsApp (formato internacional, só números, com DDI 55)
NEXT_PUBLIC_WHATSAPP_NUMBER=5561996949688

# Checkout real (Appmax/Nuvemshop)
NEXT_PUBLIC_CHECKOUT_URL=https://pay.puriongt.com.br/checkout?product=12c09776-a3c7-11f1-a1eb-46da4690ad53

# Supabase (mesmo projeto do purion-os — tabela leads_site)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# /presentes — trava operacional: ofertas a desligar (ids ou planos), ex.: "duo,trio" ou "k2"
# Lida no build (página estática): mudar exige novo deploy.
GIFT_DISABLED_OFFERS=

# ── PURION PRIVATE ACCESS / benefícios (só servidor; NUNCA com NEXT_PUBLIC_) ──
# Conexão real com o banco do CRM: DATABASE_URL (pooler do Supabase) OU
# NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY. Sem nenhuma, as páginas
# mostram "indisponível" (nada é simulado).
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32+ caracteres aleatórios — HMAC de tokens, sessões, códigos e IPs
PRIVATE_ACCESS_PEPPER=
# 32 bytes em base64 (openssl rand -base64 32) — cifra o código do voucher
BENEFITS_CODE_KEY=
# Segredo do webhook de pagamento encaminhado pelo CRM (HMAC, 32+ caracteres)
BENEFITS_WEBHOOK_SECRET=
# Emissão de tokens de acesso pelo CRM/operação (Bearer, 32+ caracteres)
PRIVATE_ACCESS_ADMIN_SECRET=
# Vercel Cron (Authorization: Bearer CRON_SECRET)
CRON_SECRET=
# off (padrão) | coupon_param — só ligar após confirmar cupom de uso único no Appmax
BENEFITS_CHECKOUT_MODE=off
APPMAX_COUPON_PARAM=
NEXT_PUBLIC_SITE_URL=https://www.puriongt.com.br
# Programa de indicações: deixe vazio até existir
NEXT_PUBLIC_REFERRALS_URL=
